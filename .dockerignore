# Everything the GPU backend image does not need.
# Note: README.md is NOT excluded - the wheel build declares it (project.readme)
# and fails without it.

.git/
.gitignore
.gitattributes
.github/

.venv/
venv/
env/
.uv/
uv-cache/

__pycache__/
*.py[cod]
*.egg-info/
.eggs/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.cache/

tests/
dist/
build/
models/
*.wav
*.log
logs/

.idea/
.vscode/
*.iml

# Secrets are injected at run time by compose, never baked into a layer.
.env
.env.*

# Host-only tooling.
scripts/*.ps1
scripts/*.bat

docs/

Thumbs.db
desktop.ini
.DS_Store

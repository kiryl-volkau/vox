# Secrets - never commit
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyd
*.so
*.egg-info/
.eggs/

# Virtualenvs / uv
.venv/
venv/
env/
.uv/
uv-cache/

# Build artefacts
build/
dist/
*.spec.bak

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.cache/

# Audio captures and downloaded model weights
*.wav
models/

# Diagnostic traces (VOX_TRACE_DIR): whole transcripts and prompts, never commit them
/traces/

# IDE. The whole directory: every file in it that mattered carried a path to somebody's
# machine - the Python SDK in misc.xml and the .iml, an AWS region in awsToolkit.xml - and
# none of it is worth a merge conflict on a shared repository.
.idea/
*.iml
.vscode/

# OS
Thumbs.db
desktop.ini
.DS_Store

# Logs
*.log
logs/

# IntelliJ plugin build output
plugin/build/
plugin/.gradle/
plugin/.intellijPlatform/

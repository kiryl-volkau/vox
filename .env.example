# vox backend configuration.
#
# Copy this file to ".env" in the repo root and edit it:
#     cp .env.example .env
#
# NEVER COMMIT ".env" - it is gitignored on purpose. It holds the address of your
# model server and possibly an API key. Only this example file belongs in git.
#
# The backend reads these variables from the process environment; docker compose
# passes ".env" through automatically. Every value below is the built-in default,
# so an empty ".env" behaves exactly like this file.


# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------

# Interface the API binds to inside the container. Keep 0.0.0.0 so the published
# port reaches it; the IntelliJ plugin talks to http://127.0.0.1:8765 on the host.
VOICE_CODE_HOST=0.0.0.0

# Container-internal port. Change the published mapping in docker/compose.yaml too.
VOICE_CODE_PORT=8765


# ---------------------------------------------------------------------------
# Speech to text (faster-whisper / CTranslate2)
# ---------------------------------------------------------------------------

# Whisper model tag or a path to a converted CTranslate2 model directory.
# "turbo" is large-v3-turbo: the best speed/quality trade-off on a 16 GB RTX card.
# Alternatives: large-v3 (slower, slightly better), medium, small.
STT_MODEL=turbo

# Primary spoken language as an ISO-639-1 code. The user speaks Russian with
# English engineering terms, so "ru" keeps Whisper from flip-flopping per segment.
# Set to an empty value to let Whisper auto-detect.
STT_LANGUAGE=ru

# auto | cuda | cpu. "auto" picks cuda when CTranslate2 reports a CUDA device,
# otherwise cpu. An explicit "cuda" that fails still falls back to CPU at load.
STT_DEVICE=auto

# float16 is correct for CUDA. On CPU it is unsupported and is downgraded to int8
# automatically. Other valid values: bfloat16, int8_float16, int8.
STT_COMPUTE_TYPE=float16

# Beam width. 1 (greedy) is fastest and is what push-to-talk latency wants.
STT_BEAM_SIZE=1

# Voice-activity filter: drops silence before decoding. Keep on for push-to-talk,
# where the tail of the recording is usually the release of the hotkey.
STT_VAD_FILTER=true

# Feed the glossary's canonical terms to Whisper as an initial prompt so that
# English technical vocabulary survives Russian speech. Set false to disable.
STT_GLOSSARY_HOTWORDS=true


# ---------------------------------------------------------------------------
# LLM (any OpenAI-compatible /v1 endpoint)
# ---------------------------------------------------------------------------

# The backend runs in Docker; the model server usually runs natively on Windows.
# "host.docker.internal" is how the container reaches the Windows host.
#
# Ollama on the Windows host (default; needs OLLAMA_HOST=0.0.0.0 on the host so it
# listens on more than loopback):
LLM_BASE_URL=http://host.docker.internal:11434/v1
#
# LM Studio on the Windows host ("Start Server" on the Developer tab):
# LLM_BASE_URL=http://host.docker.internal:1234/v1
#
# Ollama started by the bundled compose profile (docker compose --profile bundled-model up):
# LLM_BASE_URL=http://ollama:11434/v1
#
# Somebody else's hardware. Any OpenAI-compatible endpoint works - the client sends
# "Authorization: Bearer $LLM_API_KEY" and probes GET $LLM_BASE_URL/models for readiness.
# This is how you stop the LLM from using the local GPU at all: Whisper keeps it to
# itself, which frees roughly the size of the model you were running (~4.7 GB for a 7B
# Q4). Set LLM_WARMUP=false with it, and read the trade-off before you do: transcripts
# then leave this machine, which is the one thing the local-only setup guarantees.
# A shared box on the LAN, a company gateway, or a hosted provider:
# LLM_BASE_URL=http://192.168.1.50:11434/v1
# LLM_BASE_URL=https://api.example.com/v1
#
# Endpoints that are NOT OpenAI-compatible - Anthropic's own Messages API, for one - do
# not work here; they need a different client, not a different URL.

# Model tag as the server names it. Pull it first: "ollama pull qwen2.5:7b-instruct".
LLM_MODEL=qwen2.5:7b-instruct

# Local servers ignore the key but the OpenAI protocol requires a non-empty one.
# Put a real key here only when pointing LLM_BASE_URL at a hosted provider - and
# then keep this file out of git even harder.
LLM_API_KEY=local

# Hard ceiling on a single chat completion, in seconds. Exceeding it answers 504.
LLM_TIMEOUT_SECONDS=120.0

# Low temperature: the prompt reformats what was dictated, it does not invent.
LLM_TEMPERATURE=0.1

# Dictation reproduces speech rather than reformulating it, so it samples greedily.
LLM_DICTATION_TEMPERATURE=0.0

# Upper bound on generated tokens per request.
LLM_MAX_TOKENS=1024

# One throwaway completion at startup, so a local model is in VRAM before the first real
# request instead of the first dictation paying a ~30s load. Turn it OFF for a hosted
# endpoint: there is nothing there to load, so the call buys nothing and is billed like
# any other.
LLM_WARMUP=true


# ---------------------------------------------------------------------------
# Processing
# ---------------------------------------------------------------------------

# Simultaneous transcribe+LLM pipelines. One GPU, one speaker: leave at 1.
PROCESSING_CONCURRENCY=1


# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO

# Privacy switch. When false (the default) transcripts, prompts and model output
# are never written to the log. Turn it on only while debugging a bad result, and
# only together with LOG_LEVEL=DEBUG - then turn it back off.
LOG_TEXT=false


# ---------------------------------------------------------------------------
# Request tracing (off by default)
# ---------------------------------------------------------------------------

# With VOX_TRACE_DIR set, the backend writes one JSON file per request holding the
# whole provenance of it: the project file it received, what Whisper heard, the
# prompt that was assembled, the raw model output, what the cleanup changed and the
# final text. That is how you answer "why did it produce that" after the fact.
#
# THE TRADE-OFF: this is the only feature that puts transcripts and prompts on disk.
# The backend otherwise persists nothing at all - no audio, no prompts, no database.
# Leave it unset (the default) and no file is ever written; switch it on while you
# debug, then switch it back off and delete the directory.
#
# compose.yaml already mounts ./traces into the container at /traces, and /traces is
# gitignored, so this is the value to use:
# VOX_TRACE_DIR=/traces

# How many trace files to keep. After each write the oldest beyond this are deleted.
# VOX_TRACE_KEEP=200

# Read the newest one with:
#     powershell -ExecutionPolicy Bypass -File scripts\show-trace.ps1
# and list what is there with the same script and -List.


# ---------------------------------------------------------------------------
# Paths (relative to the working directory inside the container)
# ---------------------------------------------------------------------------

# The prompt that turns a transcript into a formalised task (POST /v1/process).
PROMPT_PATH=prompt.md

# The prompt that only punctuates a transcript and drops filler (POST /v1/dictate).
DICTATION_PROMPT_PATH=dictation.md

# Spoken-form to canonical-term glossary fed to the LLM and to Whisper.
GLOSSARY_PATH=config/glossary.yaml


# ---------------------------------------------------------------------------
# Upload limits
# ---------------------------------------------------------------------------

# Reject uploads larger than this many bytes with 413 (25 MB ~ 13 min of
# 16 kHz mono 16-bit WAV).
MAX_AUDIO_BYTES=25000000

# Reject decoded audio longer than this many seconds.
MAX_AUDIO_SECONDS=300.0

# Ceiling on the .vox.md a client sends. A longer file is truncated on a line
# boundary, never rejected.
MAX_PROJECT_BYTES=8000

# Ceiling on the `context` field: the recent Claude Code conversation a client
# sends so speech can refer to what was just discussed. Oldest text is dropped
# first. 0 refuses conversation context outright.
MAX_CONTEXT_BYTES=6000


# ---------------------------------------------------------------------------
# Output language
# ---------------------------------------------------------------------------

# The language the finished message is written in when the client asks for no
# particular one. Either an ISO 639-1 code or "auto".
#
# "auto" is the default and needs no configuring: the answer comes back in the
# language that was actually spoken, taken from Whisper's own detection of the
# recording. /v1/transform has no recording to detect from, so it reads the
# script of the text instead - any Cyrillic in it means Russian.
#
# A code instead of "auto" pins the language regardless of what was said, which
# is what lets Russian speech produce an English task. It is independent of
# STT_LANGUAGE either way: what is spoken and what the answer is written in
# need not match.
#
# The prompt files must carry a matching "## LANGUAGE <code>" section; a
# language with no section of its own falls back to the English one.
DEFAULT_LANGUAGE=auto
